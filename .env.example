# Yönetim paneli girişi. Hash üretmek için: npm run admin:hash -- "parolanız"
ADMIN_PASSWORD_HASH=
# En az 32 karakterlik rastgele bir değer (oturum çerezi imzası)
ADMIN_SESSION_SECRET=
# Kanonik URL ve sitemap için
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Şirket bilgileri (iletişim ve yasal sayfalarda gösterilir)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
# ipromosyon XML erişim anahtarı (bağlantının sonundaki kod). Depoya yazmayın.
IPRO_XML_KEY=
# Otomatik katalog güncelleme aralığı (dakika, en az 5)
IPRO_SYNC_MINUTES=30
# Ödemeix kartla ödeme (https://portal.odemeix.com). Anahtarlar yalnız sunucuda; depoya yazmayın.
# Panel → API Anahtarları: test için sk_test_…, canlı için sk_live_…
ODEMEIX_SECRET_KEY=
# Panel → Ayarlar → Webhook: adres https://<alan-adınız>/api/odemeix/webhook, gizli anahtar whsec_…
ODEMEIX_WEBHOOK_SECRET=
# İsteğe bağlı; varsayılan https://portal.odemeix.com/api
ODEMEIX_BASE_URL=
